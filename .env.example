# Scam Circle - example environment file.
# NOTHING here is used yet (Layer 1 is UI-only with mock data).
# Copy to .env.local in later layers and fill in real values. Never commit .env files.
#
# Only values that are safe for the browser may use the NEXT_PUBLIC_ prefix.
# Server-only values (secrets) must NEVER use the NEXT_PUBLIC_ prefix.

# Layer 4 - Supabase (browser-safe)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Layer 3 - classifier service (server-only)
# INFERENCE_URL=http://localhost:8000
# INFERENCE_SECRET=change-me

# Dev only - let a phone on your Wi-Fi load the dev server (see README)
# ALLOWED_DEV_ORIGINS=192.168.1.23
