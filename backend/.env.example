# Owlert backend — copy to .env and fill in. Never commit .env.

# Supabase project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role / secret key. Bypasses RLS — backend and seed script ONLY.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Only for projects on the legacy shared JWT secret (HS256). Leave blank if
# your project uses JWT signing keys (verified automatically via JWKS).
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Gemini (optional). Use the API key from your Google Gemini / Cloud project
# (https://aistudio.google.com/apikey lists keys for all your projects).
# Paste it with no quotes or spaces. GOOGLE_API_KEY works as the name too.
# Without it, recommendations use deterministic fallback explanations.
GEMINI_API_KEY=
# true ONLY if the key was created under Vertex AI in the Cloud console
GEMINI_USE_VERTEXAI=false
GEMINI_MODEL=gemini-3.5-flash
# Seconds before giving up and using the fallback text (Google's minimum is 10)
GEMINI_TIMEOUT_SECONDS=10
# minimal = fastest, saves free-tier quota. Leave empty for the model default
# (needed for models that don't support "minimal", e.g. gemini-3.8-flash).
GEMINI_THINKING_LEVEL=minimal
# Check your key works: .venv/bin/python -m scripts.check_gemini

# Seed script (scripts/seed_demo.py): the demo account to create
DEMO_USER_EMAIL=demo@owlert.test
DEMO_USER_PASSWORD=change-me-to-a-long-random-password
