# CloseGuard backend — copy to .env and fill in. Never commit .env.

# Supabase project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role / secret key. Bypasses RLS — backend and seed script ONLY.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Only for projects on the legacy shared JWT secret (HS256). Leave blank if
# your project uses JWT signing keys (verified automatically via JWKS).
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Gemini (optional). Free key: https://aistudio.google.com/apikey
# Without it, recommendations use deterministic fallback explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Seed script (scripts/seed_demo.py): the demo account to create
DEMO_USER_EMAIL=demo@closeguard.test
DEMO_USER_PASSWORD=change-me-to-a-long-random-password
